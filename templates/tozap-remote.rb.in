# Template for Casks/tozap-remote.rb when releases are Developer ID signed and notarized. to.zap's
# scripts/release.sh fills in the version and the SHA-256 of the published release archive; never edit
# those values by hand. Ad-hoc signed releases use tozap-remote-adhoc.rb.in instead.
cask "tozap-remote" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/skiliz/tozap/releases/download/v#{version}/tozap-#{version}.zip"
  name "to.zap"
  desc "Menu bar remote for Fire TV devices"
  homepage "https://github.com/skiliz/tozap"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on macos: :sonoma

  app "to.zap.app"

  # Only with `brew uninstall --zap`: removes the pairing and preferences. Ordinary upgrades keep them.
  zap trash: [
    "~/Library/Application Support/to.zap",
    "~/Library/Preferences/local.tozap.app.plist",
  ]
end
