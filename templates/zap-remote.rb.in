# Template for Casks/zap-remote.rb when releases are Developer ID signed and notarized. ZAP's
# scripts/release.sh fills in @VERSION@ and @SHA256@ from the published release archive; never edit those
# values by hand. Ad-hoc signed releases use zap-remote-adhoc.rb.in instead.
cask "zap-remote" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/skiliz/zap/releases/download/v#{version}/ZAP-#{version}.zip"
  name "ZAP"
  desc "Menu bar remote for Fire TV devices"
  homepage "https://github.com/skiliz/zap"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on macos: :sonoma

  app "ZAP Remote.app"

  # Only with `brew uninstall --zap`: removes the pairing and preferences. Ordinary upgrades keep them.
  zap trash: [
    "~/Library/Application Support/ZAP Remote",
    "~/Library/Preferences/local.fireremote.app.plist",
  ]
end
